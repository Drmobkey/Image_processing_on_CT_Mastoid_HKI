# ========================================================
# ENVIRONMENT VARIABLES UNTUK DOCKER COMPOSE
# ========================================================

# URL API Backend yang diakses oleh browser pengguna (frontend)
# Untuk Lokal: http://127.0.0.1:5001 atau http://localhost:5001
# Untuk Hostinger VPS: https://api.domainanda.com atau http://IP_VPS:5001
NEXT_PUBLIC_API_URL=http://127.0.0.1:5001

# URL dasar backend untuk merakit URL download hasil (PNG/DICOM)
# Sesuaikan dengan domain/IP publik backend Anda di VPS
BACKEND_URL=http://127.0.0.1:5001

# Origin frontend yang diizinkan untuk CORS (gunakan * atau domain spesifik seperti https://domainanda.com)
FRONTEND_ORIGIN=*

